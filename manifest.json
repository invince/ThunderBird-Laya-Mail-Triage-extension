{
  "manifest_version": 3,
  "name": "Laya Mail Triage",
  "version": "1.0.0",
  "description": "Classify and tag incoming mail with a local Laya decision server: categories plus a spam check.",
  "author": "invince",
  "developer": {
    "name": "invince",
    "url": "https://github.com/invince"
  },
  "homepage_url": "https://github.com/invince/ThunderBird-Laya-Mail-Triage-extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "laya-mail-triage@invince.github.io",
      "strict_min_version": "148.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesTags",
    "messagesTagsList",
    "accountsRead",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Laya Mail Triage",
    "default_popup": "popup.html"
  }
}
